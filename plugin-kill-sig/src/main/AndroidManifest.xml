<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Kill Signature Verification"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".KillSigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:grantUriPermissions="true"
            android:label="Kill signature verification">
            <intent-filter>
                <action android:name="io.github.abdurazaaqmohammed.MPManager.action.APK_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.PLUGIN_ID"
                android:value="killsig.remove" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.TITLE"
                android:value="Kill signature verification" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.APK_CHOICES"
                android:value="MT|mt,RePairip|repairip" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.APK_AUTO_SIGN"
                android:value="1" />
        </activity>

    </application>

</manifest>
